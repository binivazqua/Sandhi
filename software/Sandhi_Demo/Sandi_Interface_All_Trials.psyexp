        <Param val="marker_outlet.push_sample([&quot;botones_trial_end&quot;]);&amp;#10;console.log(&quot;EEG marker sent: botones_trial_end&quot;);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="marker_outlet.push_sample(['botones_trial_end'])&amp;#10;print(&quot;EEG marker sent: botones_trial_end&quot;)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="Timestamps2" valType="code" updates="None" name="name"/>
      </CodeComponent>
